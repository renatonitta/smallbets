<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
  </head>
  <body>
    <% @grouped_rooms.each do |source, rooms| %>
      <% icon = room_icon(source.name) %>
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom: 20px;">
        <tr>
          <td style="padding: 0 16px;">
            <p style="margin: 40px 0 8px 0; font-family: sans-serif; font-size: 18px; color: #333;">
              <%= link_to room_url(source), style: "color: #333; text-decoration: underline;" do %><%= icon %> <%= strip_emoji_from_name(source.name) || source.name %><% end %>
            </p>
          </td>
        </tr>
        <% rooms.each do |room| %>
          <% feed_card = room.automated_feed_card %>
          <tr>
            <td style="padding: 4px 16px;">
              <%= link_to room_url(room), style: "font-family: sans-serif; font-size: 16px; font-weight: bold; color: #333; text-decoration: underline;" do %>
                <%= feed_card&.title || room.name %>
              <% end %>
              <% if feed_card&.summary.present? %>
                <p style="margin: 4px 0 0 0; font-family: sans-serif; font-size: 14px; color: #333; line-height: 1.4;">
                  <%= feed_card.summary %>
                </p>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>

    <p style="font-family: sans-serif; font-size: 14px; color: #333; padding: 0 16px; margin-top: 40px;">
      Have a great weekend! If you don't want these emails anymore, <%= link_to "opt out", mailkick_unsubscribe_url(@user, "weekly_digest"), style: "color: #333;" %>.
    </p>
  </body>
</html>
